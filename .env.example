# Database
POSTGRES_PASSWORD=tendermind123
DATABASE_URL=postgresql+asyncpg://tendermind:tendermind123@postgres:5432/tendermind

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Qdrant (vector DB)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_long_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=...

# App
DEBUG=false

# Crawler settings
MATCH_VECTOR_THRESHOLD=0.72
CRAWLER_INTERVAL_MINUTES=30

# SAM.gov API key (free: https://sam.gov/content/entity-registration)
SAM_GOV_API_KEY=
